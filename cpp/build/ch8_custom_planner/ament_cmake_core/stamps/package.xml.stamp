<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ch8_custom_planner</name>
  <version>0.0.0</version>
  <description>ch8 插件机制：直线全局规划器（nav2_core::GlobalPlanner 插件）</description>
  <maintainer email="zilu@todo.todo">zilu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_core</depend>
  <depend>nav2_util</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>pluginlib</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- 告诉 pluginlib 去 plugins.xml 找 nav2_core 插件 -->
    <nav2_core plugin="${prefix}/plugins.xml"/>
  </export>
</package>
