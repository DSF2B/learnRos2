<?xml version="1.0"?>
<robot xmlns:xacro="http://www.rog.org/wiki/xacro" name="first_robot">
   <xacro:include filename="$(find ch6_bot_desc)/urdf/fishbot/common_inertial.xacro"/>

   <xacro:macro name="wheel_xacro" params="wheel_name xyz">
   <!-- 机器人轮子部分 -->
      <link name="${wheel_name}_link">
         <!-- 部件外观描述 -->
         <visual>
            <!-- 相对自己几何中心的偏移和旋转 -->
            <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
            <!-- 几何形状 -->
            <geometry>
               <cylinder radius="0.0325" length="0.04"/>
            </geometry>
            <!-- 材质颜色 -->
            <material name="yello">
               <color rgba="1.0 1.0 0.0 0.8"/>
            </material>
         </visual>
         <collision>
            <!-- 相对自己几何中心的偏移和旋转 -->
            <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
            <!-- 几何形状 -->
            <geometry>
               <cylinder radius="0.0325" length="0.04"/>
            </geometry>
            <!-- 材质颜色 -->
            <material name="yello">
               <color rgba="1.0 1.0 0.0 0.8"/>
            </material>
         </collision>
         <xacro:cylinder_inertia m="0.05" r="0.0325" h="0.04"/>
      </link>

      <!-- 关节 -->
      <joint name="${wheel_name}_joint" type="continuous">
         <parent link="base_link"/>
         <child link="${wheel_name}_link"/>
         <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
         <axis xyz="0 1 0"/>
      </joint>

      <gazebo reference="${wheel_name}_link">
         <mu1 value="20.0"/>
         <mu2 value="20.0"/>
         <kp value="1000000000.0"/>
         <kd value="1.0"/>
      </gazebo>
   </xacro:macro>
</robot>