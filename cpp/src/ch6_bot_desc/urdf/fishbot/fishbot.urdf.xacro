<?xml version="1.0"?>
<robot xmlns:xacro="http://www.rog.org/wiki/xacro" name="first_robot">
   <xacro:include filename="$(find ch6_bot_desc)/urdf/fishbot/base.urdf.xacro"/>
   <xacro:include filename="$(find ch6_bot_desc)/urdf/fishbot/sensor/imu.urdf.xacro"/>
   <xacro:include filename="$(find ch6_bot_desc)/urdf/fishbot/sensor/camera.urdf.xacro"/>
   <xacro:include filename="$(find ch6_bot_desc)/urdf/fishbot/sensor/laser.urdf.xacro"/>
   <xacro:include filename="$(find ch6_bot_desc)/urdf/fishbot/actuator/wheel.urdf.xacro"/>
   <xacro:include filename="$(find ch6_bot_desc)/urdf/fishbot/actuator/caster.urdf.xacro"/>
   <!-- <xacro:include filename="$(find ch6_bot_desc)/urdf/fishbot/plugins/gazebo_control_plugin.xacro"/> -->
   <xacro:include filename="$(find ch6_bot_desc)/urdf/fishbot/plugins/gazebo_sensor_plugin.xacro"/>
   <xacro:include filename="$(find ch6_bot_desc)/urdf/fishbot/fishbot.ros2_control.xacro"/>

   <!-- 主干 -->
   <xacro:base_xacro length="0.12" radius="0.10" />
   <!-- 传感器 -->
   <xacro:imu_xacro xyz="0.0 0.0 0.02"/>
   <xacro:camera_xacro xyz="0.10 0.0 0.075"/>
   <xacro:laser_xacro xyz="0.0 0.0 0.10"/>
   <!-- 执行器 -->
   <xacro:wheel_xacro wheel_name="left_wheel" xyz="0.0 0.10 -0.06"/>
   <xacro:wheel_xacro wheel_name="right_wheel" xyz="0.0 -0.10 -0.06"/>
   <xacro:caster_xacro caster_name="front_caster" xyz="0.08 0.0 -0.076"/>
   <xacro:caster_xacro caster_name="back_caster" xyz="-0.08 0.0 -0.076"/>
   <!-- 插件 -->
   <!-- <xacro:gazebo_control_plugin/> -->
   <xacro:gazebo_sensor_plugin/>
   <xacro:fishbot_ros2_control/>
</robot>